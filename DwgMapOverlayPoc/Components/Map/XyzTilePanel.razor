@* ─────────────────────────────────────────────────────────────────────────
   XyzTilePanel.razor
   Loads XYZ tiles from the uploaded ZIP into the browser's in-memory cache,
   then adds a custom Leaflet GridLayer that serves them without a tile server.

   Tile ZIP must be generated with gdal2tiles --xyz (standard slippy-map
   Z/X/Y layout).  No Y-axis inversion is applied.

   All C# helpers live in XyzTilePanel.razor.cs.
   ───────────────────────────────────────────────────────────────────────── *@

@inject XyzTileService  XyzService
@inject DwgAssetService AssetService
@implements IDisposable

<section class="ctrl-section" aria-label="XYZ tile controls">
    <div class="ctrl-section__title">XYZ TILES</div>

    @if (IsZipReady())
    {
        @if (IsIdle() || IsError())
        {
            <button class="btn btn-sm btn-outline-light w-100"
                    @onclick="LoadAsync">
                Load Tiles from ZIP
            </button>

            @if (XyzService.LastError is not null)
            {
                <div class="xyz-error">@XyzService.LastError</div>
            }
        }
        else if (IsLoading())
        {
            <div class="upload-progress-wrap">
                <div class="upload-progress-label">Loading tiles&hellip;</div>
                <div class="upload-progress-track">
                    <div class="upload-progress-bar xyz-loading-bar"></div>
                </div>
            </div>
        }
        else
        {
            @* Ready state *@
            <div class="xyz-info">
                <span class="xyz-count">@(XyzService.TileCount) tiles</span>
                @if (XyzService.ZoomLevels.Length > 0)
                {
                    <span class="xyz-zooms">Zoom @(FormatZooms())</span>
                }
            </div>

            @if (!XyzService.IsLayerVisible)
            {
                <button class="btn btn-sm btn-success w-100" @onclick="ShowAsync">
                    Show on Map
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-danger w-100" @onclick="HideAsync">
                    Hide
                </button>
                <div class="align-opacity-row" style="margin-top:0.4rem">
                    <label class="align-opacity-label">Opacity</label>
                    <input type="range" min="0" max="100" value="@_opacityPct"
                           class="align-opacity-slider"
                           @oninput="OnOpacityInput" />
                    <span class="align-opacity-val">@(_opacityPct)%</span>
                </div>
            }
        }
    }
    else
    {
        <p class="ctrl-placeholder">Upload an XYZ tiles ZIP to enable.</p>
    }

</section>

@code {

    protected override void OnInitialized()
    {
        XyzService.OnChanged         += HandleChanged;
        AssetService.OnAssetsChanged += HandleChanged;
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        XyzService.OnChanged         -= HandleChanged;
        AssetService.OnAssetsChanged -= HandleChanged;
    }
}

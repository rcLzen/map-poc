@* ─────────────────────────────────────────────────────────────────────────
   EquipmentPanel.razor
   Place, snap, list, and export equipment markers.
   Snap settings here control SnappingService; placement uses EquipmentService.
   GeoJSON auto-loaded from DwgAssetService when the asset becomes Ready.
   All C# helpers live in EquipmentPanel.razor.cs.
   ───────────────────────────────────────────────────────────────────────── *@

@inject EquipmentService EquipService
@inject SnappingService  SnapService
@inject DwgAssetService  AssetService
@implements IAsyncDisposable

<section class="ctrl-section" aria-label="Equipment placement">
    <div class="ctrl-section__title">EQUIPMENT</div>

    @* ── Snap controls ─────────────────────────────────────────────────── *@
    <div class="equip-snap-row">
        <label class="equip-snap-label">
            <input type="checkbox" @bind="SnapService.SnapEnabled" />
            Snap to GeoJSON
        </label>
    </div>

    @if (SnapService.SnapEnabled)
    {
        <div class="align-opacity-row" style="margin-bottom:0.4rem">
            <label class="align-opacity-label">Radius&nbsp;@(SnapService.SnapRadiusPx)px</label>
            <input type="range" min="5" max="30" class="align-opacity-slider"
                   @bind="SnapService.SnapRadiusPx" @bind:event="oninput" />
        </div>
    }

    @* ── Placement mode toggle ─────────────────────────────────────────── *@
    <div class="align-actions">
        <button class="btn btn-sm @(EquipService.PlacementMode ? "btn-warning" : "btn-outline-light") w-100"
                @onclick="TogglePlacementAsync">
            @(EquipService.PlacementMode ? "Cancel — click to place" : "Add Equipment")
        </button>
    </div>

    @* ── Equipment type selector ───────────────────────────────────────── *@
    <div class="ctrl-group equip-type-group" role="radiogroup" aria-label="Equipment type">
        <label class="ctrl-radio @(EquipService.PlacementType == EquipmentType.Valve  ? "ctrl-radio--active" : "")">
            <input type="radio" name="equip-type"
                   checked="@(EquipService.PlacementType == EquipmentType.Valve)"
                   @onchange="@(() => EquipService.PlacementType = EquipmentType.Valve)" />
            <span class="ctrl-radio__label">Valve</span>
        </label>
        <label class="ctrl-radio @(EquipService.PlacementType == EquipmentType.Pump   ? "ctrl-radio--active" : "")">
            <input type="radio" name="equip-type"
                   checked="@(EquipService.PlacementType == EquipmentType.Pump)"
                   @onchange="@(() => EquipService.PlacementType = EquipmentType.Pump)" />
            <span class="ctrl-radio__label">Pump</span>
        </label>
        <label class="ctrl-radio @(EquipService.PlacementType == EquipmentType.Sensor ? "ctrl-radio--active" : "")">
            <input type="radio" name="equip-type"
                   checked="@(EquipService.PlacementType == EquipmentType.Sensor)"
                   @onchange="@(() => EquipService.PlacementType = EquipmentType.Sensor)" />
            <span class="ctrl-radio__label">Sensor</span>
        </label>
        <label class="ctrl-radio @(EquipService.PlacementType == EquipmentType.Custom ? "ctrl-radio--active" : "")">
            <input type="radio" name="equip-type"
                   checked="@(EquipService.PlacementType == EquipmentType.Custom)"
                   @onchange="@(() => EquipService.PlacementType = EquipmentType.Custom)" />
            <span class="ctrl-radio__label">Custom</span>
        </label>
    </div>

    @* ── Marker list ───────────────────────────────────────────────────── *@
    @if (EquipService.Markers.Count > 0)
    {
        <div class="equip-list">
            @foreach (var marker in EquipService.Markers)
            {
                var m = marker;
                <div class="equip-item">
                    <span class="equip-type-dot equip-dot--@(m.Type.ToString().ToLowerInvariant())"></span>
                    <span class="equip-label" title="@(FormatMarkerCoords(m))">
                        @m.Label
                        @if (m.IsSnapped)
                        {
                            <span class="equip-snap-badge" title="Snapped to GeoJSON">&#x2299;</span>
                        }
                    </span>
                    <button class="btn btn-sm btn-outline-danger equip-remove"
                            @onclick="@(() => RemoveMarkerAsync(m.Id))">&#x2715;</button>
                </div>
            }
        </div>

        <div class="align-actions" style="margin-top:0.4rem">
            <button class="btn btn-sm btn-outline-light" @onclick="ExportAsync">
                Export GeoJSON
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ClearAllAsync">
                Clear All
            </button>
        </div>
    }
    else
    {
        <p class="ctrl-placeholder">
            Click "Add Equipment" then click the map to place a marker.
        </p>
    }

</section>

@code {

    protected override void OnInitialized()
    {
        EquipService.OnChanged        += HandleChanged;
        AssetService.OnAssetsChanged  += HandleChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EquipService.InitAsync();
            CheckAndLoadGeoJson();
        }
    }

    private void HandleChanged()
    {
        CheckAndLoadGeoJson();
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        EquipService.OnChanged       -= HandleChanged;
        AssetService.OnAssetsChanged -= HandleChanged;
        await ValueTask.CompletedTask;
    }
}

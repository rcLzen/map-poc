@* ─────────────────────────────────────────────────────────────────────────
   MapExportPanel.razor
   EXPORT sidebar section (Task 10).

   Provides:
     • Screenshot Map  — html2canvas capture of the Leaflet viewport as PNG
     • Export Equipment — GeoJSON download of all placed markers (count shown)

   Cross-origin tile note: OSM / CartoDB / Mapbox tiles are served without
   permissive CORS headers, so html2canvas renders them as blank squares.
   TMS tiles loaded from the in-memory ZIP cache (blob: URLs) are captured
   correctly.  The rotated PNG overlay (also a blob: URL) is captured too.
   ───────────────────────────────────────────────────────────────────────── *@

@inject IJSRuntime JS
@inject EquipmentService EquipService

<section class="ctrl-section" aria-label="Map export">
    <div class="ctrl-section__title">EXPORT</div>

    <div class="d-grid gap-2">

        @* Screenshot button *@
        <button class="btn btn-sm btn-outline-primary"
                @onclick="ScreenshotAsync"
                disabled="@_busy"
                title="Capture map viewport as PNG (blob-sourced tiles only)">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-1"
                      role="status" aria-hidden="true"></span>
            }
            Screenshot Map
        </button>

        @* GeoJSON export – disabled when no markers placed *@
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="ExportGeoJsonAsync"
                disabled="@(EquipService.Markers.Count == 0)"
                title="Download placed markers as GeoJSON">
            Export Equipment
            @if (EquipService.Markers.Count > 0)
            {
                <span class="badge bg-secondary ms-1">@EquipService.Markers.Count</span>
            }
        </button>

    </div>

    @* Status line – appears briefly after an action *@
    @if (_statusMessage is not null)
    {
        <div class="mt-2 small export-status @_statusClass">@_statusMessage</div>
    }

</section>

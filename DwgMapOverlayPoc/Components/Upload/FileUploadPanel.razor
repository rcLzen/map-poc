@* ──────────────────────────────────────────────────────────────────────────
   FileUploadPanel.razor
   Three upload cards rendered inside the sidebar ASSETS section.

   InputFile stability strategy
   ─────────────────────────────
   Each card renders exactly ONE <InputFile> element, ALWAYS present in the
   DOM regardless of upload state.  A Guid (@key) pins Blazor to the same
   underlying <input> element across every re-render, so the browser-side
   _blazorFilesById entry is never cleared mid-stream.

   After an upload completes (success or error) or the asset is removed, the
   Guid is rotated in the code-behind so the next file selection starts with a
   clean element.

   The label's `for` attribute always matches the single InputFile id for each
   card — idle, retry, and re-upload labels all share the same id.

   All C# helpers live in FileUploadPanel.razor.cs (partial class).
   ────────────────────────────────────────────────────────────────────────── *@

@inject DwgAssetService AssetService
@implements IDisposable

@* ══════════════════════════════════════════════════════════════════════════
   PNG card
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="upload-card @CardCss(AssetService.PngAsset)">

    <div class="upload-card__header">
        <span class="upload-card__title">DWG Raster PNG</span>
        @if (ShowBadge(AssetService.PngAsset))
        {
            <span class="upload-badge @BadgeCss(AssetService.PngAsset)"
                  title="@BadgeTitle(AssetService.PngAsset)">@BadgeText(AssetService.PngAsset)</span>
        }
        @if (AssetService.PngAsset is not null)
        {
            <button class="upload-remove" title="Remove" @onclick="RemovePngAsync">&#x2715;</button>
        }
    </div>

    @* Single always-present InputFile — @key keeps the DOM element stable *@
    <InputFile @key="_pngKey"
               id="upload-png"
               accept=".png"
               Multiple="false"
               class="upload-input-hidden"
               OnChange="HandlePngChangeAsync" />

    @if (AssetService.PngAsset is null)
    {
        <label class="upload-drop-zone" for="upload-png">
            <span class="upload-drop-zone__icon">&#x1F4C2;</span>
            <span>Choose PNG&hellip;</span>
        </label>
        <div class="upload-limit">max @FormatMaxMB(DwgAssetService.MaxPngBytes)</div>
    }
    else if (AssetService.PngAsset.Status == UploadStatus.Reading
          || AssetService.PngAsset.Status == UploadStatus.Processing)
    {
        <div class="upload-progress-wrap">
            <div class="upload-progress-label">
                @StatusLabel(AssetService.PngAsset) &nbsp;@AssetService.PngAsset.ProgressPercent%
            </div>
            <div class="upload-progress-track">
                <div class="upload-progress-bar"
                     style="width: @(AssetService.PngAsset.ProgressPercent)%"></div>
            </div>
        </div>
    }
    else if (AssetService.PngAsset.Status == UploadStatus.Error)
    {
        <div class="upload-error-msg">@AssetService.PngAsset.ErrorMessage</div>
        <label class="upload-drop-zone upload-drop-zone--retry" for="upload-png">
            <span class="upload-drop-zone__icon">&#x1F4C2;</span>
            <span>Retry&hellip;</span>
        </label>
    }
    else
    {
        @if (AssetService.PngAsset.ThumbnailDataUrl is string pngThumb)
        {
            <img class="upload-thumb" src="@pngThumb" alt="PNG preview" />
        }
        <div class="upload-file-info">
            <span class="upload-file-name" title="@AssetService.PngAsset.Name">
                @AssetService.PngAsset.Name
            </span>
            <span class="upload-size">@AssetService.PngAsset.FormattedSize</span>
        </div>
        @if (AssetService.PngAsset.IsStub)
        {
            <p class="upload-stub-warn">&#x26A0; Re-upload to activate on map.</p>
            <label class="upload-reupload-btn" for="upload-png">Re-upload</label>
        }
    }

</div>


@* ══════════════════════════════════════════════════════════════════════════
   ZIP card
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="upload-card @CardCss(AssetService.ZipAsset)">

    <div class="upload-card__header">
        <span class="upload-card__title">XYZ Tiles ZIP</span>
        @if (ShowBadge(AssetService.ZipAsset))
        {
            <span class="upload-badge @BadgeCss(AssetService.ZipAsset)"
                  title="@BadgeTitle(AssetService.ZipAsset)">@BadgeText(AssetService.ZipAsset)</span>
        }
        @if (AssetService.ZipAsset is not null)
        {
            <button class="upload-remove" title="Remove" @onclick="RemoveZipAsync">&#x2715;</button>
        }
    </div>

    @* Single always-present InputFile — @key keeps the DOM element stable *@
    <InputFile @key="_zipKey"
               id="upload-zip"
               accept=".zip"
               Multiple="false"
               class="upload-input-hidden"
               OnChange="HandleZipChangeAsync" />

    @if (AssetService.ZipAsset is null)
    {
        <label class="upload-drop-zone" for="upload-zip">
            <span class="upload-drop-zone__icon">&#x1F4C2;</span>
            <span>Choose ZIP&hellip;</span>
        </label>
        <div class="upload-limit">max @FormatMaxMB(DwgAssetService.MaxZipBytes)</div>
    }
    else if (AssetService.ZipAsset.Status == UploadStatus.Reading
          || AssetService.ZipAsset.Status == UploadStatus.Processing)
    {
        <div class="upload-progress-wrap">
            <div class="upload-progress-label">
                @StatusLabel(AssetService.ZipAsset) &nbsp;@AssetService.ZipAsset.ProgressPercent%
            </div>
            <div class="upload-progress-track">
                <div class="upload-progress-bar"
                     style="width: @(AssetService.ZipAsset.ProgressPercent)%"></div>
            </div>
        </div>
    }
    else if (AssetService.ZipAsset.Status == UploadStatus.Error)
    {
        <div class="upload-error-msg">@AssetService.ZipAsset.ErrorMessage</div>
        <label class="upload-drop-zone upload-drop-zone--retry" for="upload-zip">
            <span class="upload-drop-zone__icon">&#x1F4C2;</span>
            <span>Retry&hellip;</span>
        </label>
    }
    else
    {
        <div class="upload-file-info">
            <span class="upload-file-name" title="@AssetService.ZipAsset.Name">
                @AssetService.ZipAsset.Name
            </span>
            <span class="upload-size">@AssetService.ZipAsset.FormattedSize</span>
        </div>
        @if (AssetService.ZipAsset.IsStub)
        {
            <p class="upload-stub-warn">&#x26A0; Re-upload to activate on map.</p>
            <label class="upload-reupload-btn" for="upload-zip">Re-upload</label>
        }
        @if (AssetService.ZipAsset.ZipContents != null && AssetService.ZipAsset.ZipContents.Count > 0)
        {
            <details class="upload-zip-tree">
                <summary class="upload-zip-summary">
                    @AssetService.ZipAsset.ZipContents.Count entries
                    @if (AssetService.ZipAsset.ZipContents.Count >= 200)
                    {
                        <span class="upload-zip-capped">(capped at 200)</span>
                    }
                </summary>
                <ul class="upload-zip-list">
                    @foreach (var entry in GetZipShown())
                    {
                        <li class="@ZipEntryCss(entry)">
                            <span class="upload-zip-icon">
                                @(entry.IsDirectory ? "📁" : "📄")
                            </span>
                            <span class="upload-zip-name" title="@entry.Name">
                                @TrimPath(entry.Name)
                            </span>
                            @if (!entry.IsDirectory && entry.Size > 0)
                            {
                                <span class="upload-zip-size">@FormatBytes(entry.Size)</span>
                            }
                        </li>
                    }
                    @if (AssetService.ZipAsset.ZipContents.Count > 50)
                    {
                        <li class="upload-zip-more">
                            &hellip; @(AssetService.ZipAsset.ZipContents.Count - 50) more
                        </li>
                    }
                </ul>
            </details>
        }
    }

</div>

@code {

    protected override void OnInitialized()
        => AssetService.OnAssetsChanged += HandleAssetsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await AssetService.LoadMetadataAsync();
    }

    public void Dispose()
        => AssetService.OnAssetsChanged -= HandleAssetsChanged;

    private void HandleAssetsChanged() => InvokeAsync(StateHasChanged);
}
